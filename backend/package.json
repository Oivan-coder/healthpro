{
  "name": "health-id-backend",
  "version": "5.0.0",
  "description": "Express backend API with MySQL data layer for Атлас здоровья patient cabinet MVP.",
  "main": "src/server.js",
  "scripts": {
    "db:init": "node src/db/init.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:seed:users": "node src/db/seedDemoUsers.js",
    "dictionary:inspect": "node src/import/dictionaryImport.js inspect",
    "dictionary:import": "node src/import/dictionaryImport.js import",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js"
  },
  "dependencies": {
    "@simplewebauthn/server": "13.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.18.3",
    "mysql2": "^3.12.0",
    "xlsx": "^0.18.5"
  }
}