NODE_ENV=development
PORT=3001

# Storage mode: json for local demo, mysql for hosted/production.
USE_DB=json
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=health_id_mvp

# Comma-separated frontend origins allowed to call the API.
# Example production value: https://atlas.example.ru
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# Synthetic accounts used only by the explicit db:seed:users command.
# Passwords are intentionally not committed. Provide them in the environment before seeding.
DEMO_ORGANIZATION_ID=org_demo
DEMO_ORGANIZATION_NAME=Демо-клиника Атласа здоровья
DEMO_ADMIN_LOGIN=
DEMO_ADMIN_PASSWORD=
DEMO_USER_LOGIN=
DEMO_USER_PASSWORD=
DEMO_USER_DISPLAY_NAME=Иванов Иван Иванович
DEMO_USER_PATIENT_ID=p_001

AI_ENABLED=false
AI_PROVIDER=mock
GIGACHAT_AUTH_KEY=
# Alternatively, backend can build auth key from:
# GIGACHAT_CLIENT_ID=
# GIGACHAT_CLIENT_SECRET=
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_TIMEOUT_MS=12000
# Local dev only if Node fails with SELF_SIGNED_CERT_IN_CHAIN.
# Keep true in staging/production and use GIGACHAT_CA_CERT_PATH instead.
GIGACHAT_REJECT_UNAUTHORIZED=true
# GIGACHAT_CA_CERT_PATH=
